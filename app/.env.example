# Copie para app/.env e preencha.
NODE_ENV=development
# Porta da API (o client usa NEXT_PUBLIC_API_URL=http://localhost:3333)
PORT=3333
# PostgreSQL do compose.yaml (porta 15432). Use DB_USER/DB_PASSWORD/DB_NAME do .env da raiz.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:15432/BANCO?schema=public"
# Origens liberadas no CORS (com cookies), separadas por vírgula
CORS_ORIGIN="http://localhost:3000"
# Mínimo 32 caracteres — gere com: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-com-pelo-menos-32-caracteres"

# Admin inicial criado pelo seed (pnpm db:seed)
ADMIN_SEED_NOME="Admin"
ADMIN_SEED_EMAIL="admin@tanaka.dev"
ADMIN_SEED_PASSWORD="troque-esta-senha"
