# URL do backend NestJS (docs/back)
NEXT_PUBLIC_API_URL="http://localhost:3333"
# true = usa src/data/mock.ts e simula o envio do formulário (sem backend)
NEXT_PUBLIC_USE_MOCKS="true"

# --- Admin (somente desenvolvimento: ignorado em `next build`/`next start`) ---
# true = entra no /admin direto, sem tela de login
ADMIN_DEV_BYPASS="false"
# Credenciais do login mock (usado quando NEXT_PUBLIC_USE_MOCKS="true")
ADMIN_DEV_EMAIL="admin@tanaka.dev"
ADMIN_DEV_PASSWORD="admin123"

# --- Demonstração pública (ex.: Vercel sem backend) ---
# true (+ NEXT_PUBLIC_USE_MOCKS="true") = libera o login mock em produção, com as credenciais
# ADMIN_DEV_EMAIL/ADMIN_DEV_PASSWORD exibidas na tela de login. Dados fictícios; nada é salvo.
DEMO_MODE="false"
