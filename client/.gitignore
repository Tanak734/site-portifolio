# Regras do app Next.js (as gerais do monorepo estão no .gitignore da raiz).
# https://help.github.com/articles/ignoring-files/

# dependências
/node_modules
/.pnp
.pnp.*

# testes
/coverage

# next.js
/.next/
/out/
/build

# variáveis de ambiente — o modelo .env.example é versionado
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
