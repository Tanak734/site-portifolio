# ─────────────────────────────────────────────────────────────
# Monorepo pnpm: client (Next.js) + server (Fastify + Prisma)
# Regras específicas do Next também ficam em client/.gitignore
# ─────────────────────────────────────────────────────────────

# ── Dependências ──
node_modules/
.pnpm-store/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# O projeto usa pnpm: locks de outros gerenciadores não entram (evita conflito com o pnpm-lock.yaml)
package-lock.json
yarn.lock
bun.lock
bun.lockb

# ── Variáveis de ambiente (segredos) ──
# Só os modelos .env.example vão para o repositório.
.env
.env.*
!.env.example
!**/.env.example

# ── Builds e caches ──
dist/
build/
out/
.next/
.turbo/
.vercel/
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
next-env.d.ts

# ── Testes e cobertura ──
coverage/
.nyc_output/
test-results/
playwright-report/
.vitest/

# ── Banco de dados local ──
*.db
*.db-journal
*.sqlite
*.sqlite3
server/prisma/dev.db*
# Dumps/backups gerados localmente
*.dump
*.sql.gz
backups/

# ── Uploads locais do backend (mantém a pasta via .gitkeep) ──
server/uploads/*
!server/uploads/.gitkeep

# ── Certificados e chaves ──
*.pem
*.key
*.crt
*.p12

# ── Logs ──
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ── Arquivos temporários do admin (escrita atômica do site-content.json) ──
*.tmp

# ── Editores e IDEs ──
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# ── Sistema operacional ──
.DS_Store
Thumbs.db
Desktop.ini
.directory

# ── Ferramentas de IA (configurações locais/pessoais) ──
.claude/settings.local.json
CLAUDE.local.md
