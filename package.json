{
  "name": "site-pessoal-hub",
  "private": true,
  "version": "1.0.0",
  "description": "Plataforma Pessoal Integrada de Portfólio, CMS, Ideias, Projetos, Calculadoras e Chamados (Next.js + NestJS Modular + Prisma + PostgreSQL)",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev:server": "pnpm --filter @portfolio/server dev",
    "dev:client": "pnpm --filter @portfolio/client dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @portfolio/server db:generate",
    "db:push": "pnpm --filter @portfolio/server db:push",
    "db:migrate": "pnpm --filter @portfolio/server db:migrate",
    "db:seed": "pnpm --filter @portfolio/server db:seed",
    "prisma:studio": "pnpm --filter @portfolio/server prisma:studio"
  }
}
